# Dev flavor environment — committed (contains no secrets, just the API host).
# Consumed at build time by envied (core/config/env.dart). Never read at runtime.
API_BASE_URL=https://dev.mulearn.org
# Google OAuth web client id (Android serverClientId). Empty = Google sign-in hidden on Android.
GOOGLE_SERVER_CLIENT_ID=
# The μLearn web dashboard (company sign-up is handed off there).
DASHBOARD_URL=https://dev.mulearn.org
