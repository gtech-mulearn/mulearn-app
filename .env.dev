# Dev flavor environment — committed (contains no secrets, just the API host).
# Consumed at build time by envied (core/config/env.dart). Never read at runtime.
API_BASE_URL=https://dev.mulearn.org
# Google OAuth web client id (Android serverClientId). Empty = Google sign-in hidden on Android.
GOOGLE_SERVER_CLIENT_ID=
# The μLearn web dashboard (company sign-up and web-only screens are handed off
# there). The dev dashboard is the Vercel build (dev.mulearn.org's web root is
# the marketing site).
DASHBOARD_URL=https://mulearn-dashboard.vercel.app
# Discord OAuth authorize URL — the dev dashboard's NEXT_PUBLIC_DISCORD_AUTH_URL.
# Its redirect_uri host must match android/app/build.gradle.kts
# (discordRedirectHost). Empty = Connect Discord hidden.
DISCORD_AUTH_URL=https://discord.com/oauth2/authorize?client_id=785516660160593940&response_type=code&redirect_uri=https%3A%2F%2Fmulearn-dev.vercel.app%2Fdashboard%2Fconnect-discord&scope=identify+guilds+guilds.join
